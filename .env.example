# AI4 Contact Center — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.

# ─── Runtime flow authority ───────────────────────────────────────────────────
# Valid values: dev, qa, staging, production
# Non-production may use controlled fallbacks. Production requires an explicitly
# deployed canonical flow version for the tenant + channel + environment.
AI4CC_RUNTIME_ENVIRONMENT=dev

# ─── OpenAI (AI-powered parser) ───────────────────────────────────────────────
# If set, the builder uses GPT-4o-mini for parsing. Falls back to rule engine if missing.
OPENAI_API_KEY=

# ─── Supabase (auth + cloud flow storage) ─────────────────────────────────────
# Get these from your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
